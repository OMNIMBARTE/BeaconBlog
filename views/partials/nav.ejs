<header class="masthead" id="masthead">
  <div class="wrap masthead__top">
    <span class="masthead__date">Dispatches &amp; dog-eared thoughts</span>
    <span class="masthead__tagline">Vol. 1 &middot; Est. <%= new Date().getFullYear() %></span>
  </div>
  <div class="wrap masthead__main">
    <a href="/" class="brand">Blog<span>ify</span></a>

    <div class="nav-actions">
      <% if (locals.user) { %>
        <nav class="navlinks" id="navlinks">
          <a href="/">Home</a>
          <a href="/blog/add-new">Write</a>
        </nav>
        <a href="/blog/add-new" class="btn-write">New post</a>
        <div class="user-chip">
          <button type="button" class="user-chip__btn" aria-haspopup="true" aria-expanded="false">
            <img src="/images/default.png" alt="">
            <span class="user-chip__name"><%= locals.user.fullname %></span>
            <span class="user-chip__caret">▾</span>
          </button>
          <div class="user-chip__menu" role="menu">
            <a href="/blog/add-new" role="menuitem">✍️ Write</a>
            <div class="user-chip__menu-divider"></div>
            <a href="/user/logout" role="menuitem">Sign out</a>
          </div>
        </div>
      <% } else { %>
        <nav class="navlinks" id="navlinks">
          <a href="/">Home</a>
          <a href="/user/signup">Create account</a>
        </nav>
        <a href="/user/signin" class="btn-write">Sign in</a>
      <% } %>

      <!-- Theme Picker -->
      <div class="theme-picker" id="themePicker" aria-label="Change theme">
        <button type="button" class="theme-picker__btn" id="themePickerBtn" aria-haspopup="true" aria-expanded="false" title="Change theme">
          <span id="themeIcon">🎨</span>
        </button>
        <div class="theme-picker__menu" id="themePickerMenu" role="menu">
          <span class="theme-picker__label">Theme</span>
          <button class="theme-option" data-theme="newsprint" role="menuitem">
            <span class="theme-option__swatch" style="background:#FAF7F1; border-color:#DED7C7;"></span>
            Newsprint
          </button>
          <button class="theme-option" data-theme="dark" role="menuitem">
            <span class="theme-option__swatch" style="background:#18181B; border-color:#2E2D33;"></span>
            Dark
          </button>
          <button class="theme-option" data-theme="slate" role="menuitem">
            <span class="theme-option__swatch" style="background:#EEF2F8; border-color:#C4CDE0;"></span>
            Slate
          </button>
          <button class="theme-option" data-theme="forest" role="menuitem">
            <span class="theme-option__swatch" style="background:#F2F0E7; border-color:#BFD0AA;"></span>
            Forest
          </button>
        </div>
      </div>

      <button type="button" class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navlinks">
        <span></span>
      </button>
    </div>
  </div>
</header>

<% if (locals.error) { %>
  <div class="alert" role="alert"><%= locals.error %></div>
<% } %>
