<link rel="stylesheet" href="/css/style.css">
<!-- Apply saved theme BEFORE paint to prevent flash -->
<script>
  (function(){
    try{
      var t = localStorage.getItem('blogify-theme');
      if(t && t !== 'newsprint') document.documentElement.setAttribute('data-theme', t);
    }catch(e){}
  })();
</script>
